# Ignore editor specific config folders/files
/.vscode

# Ignore compilation result directories
/build
/output
/docs/api
/_site

# Ignore generated files in the libdragon FS
/filesystem/*.font64
/filesystem/N64
/filesystem/menu

# Emulator test data built from local ROMs (scripts/make_devsd.py)
/devsd
/filesystem/*.wav64
/filesystem/*.wav
/filesystem/*.sprite
/filesystem/boot
/filesystem/loading

# Ignore external development tools
/tools/*

# Ignore any N64 ROM
**/*.n64
**/*.v64
**/*.z64

# Ignore exe files
*.exe

# Ignore macOS filesystem cruft
.DS_Store
__pycache__/
